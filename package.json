{
  "name": "specwright-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that keeps specs, decisions and project memory as the source of truth for AI coding agents, and packs the minimal context for each task.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "spec-driven-development",
    "claude-code",
    "acceptance-criteria",
    "adr",
    "project-memory"
  ],
  "homepage": "https://github.com/ThiagoNascBarros/specwright#readme",
  "bugs": {
    "url": "https://github.com/ThiagoNascBarros/specwright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThiagoNascBarros/specwright.git"
  },
  "license": "MIT",
  "author": "ThiagoNascBarros",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "specwright-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:load": "npm run build && vitest run --config vitest.load.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
